# Required: Supabase Postgres URL (Transaction pooler, web project)
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase pooler best practice: disable SQLAlchemy client pooling
DB_USE_NULL_POOL=true

# Order behavior
ORDER_HOLD_HOURS=24

SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MERCADOPAGO_ACCESS_TOKEN=your_access_token
MERCADOPAGO_PUBLIC_KEY=your_public_key
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Super admin bootstrap (created on startup if not exists)
SUPER_ADMIN_EMAIL=rojas.augusto@admin.local
SUPER_ADMIN_PASSWORD=RojasCarlosAugusto1@
SUPER_ADMIN_FIRST_NAME=Rojas
SUPER_ADMIN_LAST_NAME=Augusto

# Optional Supabase public config for frontend integrations
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
